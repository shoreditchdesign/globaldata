{
  "name": "@globaldata/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/index.css"
  },
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly -p tsconfig.build.json",
    "lint": "oxlint src && stylelint \"src/**/*.css\"",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@globaldata/design-tokens": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1"
  },
  "peerDependencies": {
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@globaldata/config": "workspace:*",
    "@storybook/react-vite": "10.5.6",
    "@vitejs/plugin-react": "^6.0.4",
    "@types/react": "^19.2.18",
    "oxlint": "^1.75.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "stylelint": "^17.14.1",
    "typescript": "~6.0.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
